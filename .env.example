# Copy to `.env` and export before running the scripts.

# ── Embedding backend for the regulation RAG ──────────────────────────────
#   auto     — probe Ollama → GGUF → Bedrock → stub (default)
#   ollama | gguf | bedrock | stub
# `stub` returns zero vectors: the index builds, but retrieval has no ranking signal.
# REGLLM_EMBED_BACKEND=auto

# Ollama
# OLLAMA_URL=http://localhost:11434
# REGLLM_EMBED_MODEL=nomic-embed-text
# REGLLM_EMBED_DIM=768

# Standalone GGUF (llama-cpp-python)
# GGUF_EMBED_MODEL_PATH=/models/nomic-embed-text-v1.5.Q8_0.gguf

# Amazon Bedrock
# BEDROCK_REGION=eu-west-1
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
