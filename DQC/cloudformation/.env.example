# DQC PoC — CloudFormation Backend Setup
# Generated by CloudFormation — copy to .env.local and update values
#
# This file is created for the CloudFormation stack deployed via:
#   DQC/cloudformation/deploy.sh
#
# Issues resolved:
#   #4  — Configure AWS backend with application
#   #5  — API to call Nova Micro via Bedrock
#   #6  — S3 bucket for data/prompts/rules
#   #7  — Lambda to find implicated fields
#   #8  — CloudFormation scripts
#   #9  — Lambda to generate SQL with retry + LLM-as-judge
#   #10 — DynamoDB to store DQCs by project
#   #2  — BCBS 239 classification

# ── API Gateway (Issues #4, #5) ──
# Base URL from CloudFormation: DqcApiUrl output
DQC_API_URL=https://<api-id>.execute-api.eu-west-1.amazonaws.com/prod
DQC_API_FIELDS=${DQC_API_URL}/fields
DQC_API_GENERATE=${DQC_API_URL}/generate
DQC_API_JUDGE=${DQC_API_URL}/judge
DQC_API_BCBS=${DQC_API_URL}/bcbs
DQC_API_CHECKS=${DQC_API_URL}/checks
DQC_API_HEALTH=${DQC_API_URL}/health

# ── S3 Bucket (Issue #6) ──
# Created by CloudFormation: DqcDataBucket output
DQC_S3_BUCKET=dqc-poc-data-<account-id>
DQC_S3_REGION=eu-west-1

# ── DynamoDB Table (Issue #10) ──
# Created by CloudFormation: DqcStoreTableName output
# Partition key: report_id (project_id)
# Sort key: report_sort (dqc_id or hash of rule)
DQC_DYNAMODB_TABLE=dqc-poc-dqc-store
DQC_DYNAMODB_REGION=eu-west-1

# ── Bedrock (Issues #4, #5) ──
# Nova Micro for DQC generation, Nova Pro for judge
BEDROCK_MODEL_ID=eu.amazon.nova-micro-v1:0
BEDROCK_JUDGE_MODEL_ID=eu.amazon.nova-pro-v1:0
BEDROCK_REGION=eu-west-1

# ── Lambda Functions (Issues #7, #9, #2) ──
LAMBDA_FIND_FIELDS=dqc-poc-find-fields
LAMBDA_SQL_GENERATOR=dqc-poc-sql-generator
LAMBDA_BCBS_CLASSIFIER=dqc-poc-bcbs-classifier

# ── ECS Cluster/Service ──
ECS_CLUSTER=dqc-poc
ECS_SERVICE=dqc-poc

# ── ALB (UI access) ──
# From CloudFormation: AlbUrl output
ALB_DNS=<alb-dns>.eu-west-1.elb.amazonaws.com
ALB_URL=http://<alb-dns>.eu-west-1.elb.amazonaws.com

# ── ECR (Docker images) ──
ECR_API_URI=<account-id>.dkr.ecr.eu-west-1.amazonaws.com/dqc-poc-api
ECR_DQC_URI=<account-id>.dkr.ecr.eu-west-1.amazonaws.com/dqc-poc-dqc

# ── AWS ──
AWS_REGION=eu-west-1
AWS_ACCOUNT_ID=<account-id>

# ── Original Docker Compose settings (for local dev) ──
# These remain unchanged for local development
REGLLM_LLM=api
REGLLM_API_URL=https://api.nan.builders
REGLLM_API_MODEL=qwen3.6
NAN_API_KEY=
NAN_API_MODEL=qwen3.6